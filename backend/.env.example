# MATS Platform - Environment Configuration Template
PROJECT_NAME="MATS - Multi-Agent Autonomous Financial Intelligence Platform"
API_V1_STR="/api/v1"

# Security & Tokens (Generate unique secrets for production)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./mats.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mats

# Whitelisted Web Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Market Data Providers (hybrid, yahoo, mock)
MARKET_DATA_PROVIDER=hybrid
FINNHUB_API_KEY=

# RAG & Semantic Embeddings (local, openai)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
MAX_DOCUMENT_SIZE_BYTES=10485760
