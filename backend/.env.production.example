# MATS Production Environment Template
PROJECT_NAME="MATS - Multi-Agent Autonomous Financial Intelligence Platform"
API_V1_STR="/api/v1"
JWT_SECRET="GENERATE_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING"
